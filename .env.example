# Copy to .env (never commit .env) and export these in the deployment environment.

# Port the container / process listens on (Dockerfile default 8000).
PORT=8000

# Dataset and portal locations (defaults shown; only set if you relocate them).
# LANDSTACK_DATA_ROOT=/app/landstack
# LANDSTACK_FRONTEND_DIR=/app/frontend
# Evaluation date for lag calculations (ISO date); defaults to today.
# LANDSTACK_AS_OF=2026-01-01

# Optional AI assistant (the portal works without it).
# ANTHROPIC_API_KEY=
# LANDSTACK_ASSISTANT_MODEL=
# Optional alternative chat providers (see backend/interop/chat.py).
# LANDSTACK_CHAT_PROVIDER=
# LANDSTACK_CHAT_MODEL=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
